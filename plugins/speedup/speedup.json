{
  "id": "speedup",
  "name": "Speedup",
  "version": "1.0.0",
  "manifestURI": "https://raw.githubusercontent.com/AksharLeo/seanime-extensions/main/plugins/speedup/speedup.json",
  "language": "typescript",
  "type": "plugin",
  "description": "Hold a key to double playback speed. Note: This plugin only works with the built-in HTML5 web player.",
  "author": "aksharleo",
  "icon": "",
  "website": "https://github.com/AksharLeo/seanime-extensions",
  "lang": "en",
  "payload": "",
  "payloadURI": "https://raw.githubusercontent.com/AksharLeo/seanime-extensions/main/plugins/speedup/speedup.ts",
  "userConfig": {
    "version": 1,
    "requiresConfig": false,
    "fields": [
      {
        "name": "speedKey",
        "label": "Speed Key",
        "type": "text",
        "default": "c",
        "description": "Key to hold down for 2x speed. (e.g. c, Shift, Space)"
      }
    ]
  },
  "plugin": {
    "version": "1",
    "permissions": {
      "scopes": [
        "playback"
      ]
    }
  }
}
